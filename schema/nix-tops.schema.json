{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Protocol 0.2.0. No $id on purpose: references to core/ are relative, so the schema validates from a checkout without network access.",
  "title": "Nix-TOPS configuration",
  "description": "nix-tops.toml, converted to JSON, at protocol 0.2.0. Covers every key in NIX_TOPS.md section 9. A profile file (section 5.3) validates against it too: it has the same shape with facet in place of facets.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol"],
  "oneOf": [
    {
      "description": "A configuration: facets and the exported systems are required.",
      "required": ["facets", "toolchain"],
      "properties": { "toolchain": { "required": ["systems"] } },
      "not": { "required": ["facet"] }
    },
    {
      "description": "A profile file: one facet, no facets list.",
      "required": ["facet"],
      "not": { "required": ["facets"] }
    }
  ],
  "$defs": {
    "facet": {
      "enum": ["dev-flake", "package-set", "nixos-module", "flake-lib", "nixos-host", "home-config",
               "darwin-host", "fleet-root", "image"]
    },
    "layerOff": {
      "description": "A layer of the gate report switched off. The only value is off, and the reason is required; the report shows the layer as skip with it (section 6.7).",
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "reason"],
      "properties": {
        "enabled": { "const": false },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "tier": { "type": "integer", "minimum": 0, "maximum": 2 }
      }
    }
  },
  "properties": {
    "protocol": { "const": "0.2.0" },
    "facet": { "$ref": "#/$defs/facet" },
    "facets": {
      "description": "A subset of the facets the outputs show (section 5.4); never adds one.",
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/facet" }
    },
    "enforce": { "$ref": "core/core.schema.json#/$defs/mode", "default": "ratchet" },
    "baseline": { "type": "string", "minLength": 1 },
    "nixpkgs_input": {
      "description": "The flake input that is the adopter's main nixpkgs; N-06 and N-43 read it.",
      "type": "string", "minLength": 1, "default": "nixpkgs"
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nix_floor": { "type": "string", "pattern": "^2\\.[0-9]+$" },
        "systems": {
          "description": "Equals the systems the flake's outputs export (checked by nixtops check). x86_64-darwin is unsupported.",
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["x86_64-linux", "aarch64-linux", "aarch64-darwin"] }
        }
      }
    },
    "eval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "all_systems": { "type": "boolean" },
        "abort_on_warn": { "const": true },
        "allow_ifd": {
          "description": "The default for the whole flake. IFD is allowed per output by an N-07 ack, not by this key.",
          "const": false
        }
      }
    },
    "warnings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": {
          "type": "array",
          "items": {
            "description": "An ack with an expiry (section 3.1).",
            "type": "object",
            "additionalProperties": false,
            "required": ["match", "reason", "until"],
            "properties": {
              "match": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 },
              "until": { "$ref": "core/core.schema.json#/$defs/date" }
            }
          }
        }
      }
    },
    "lint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "statix": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "config": { "type": "string", "minLength": 1 } }
        },
        "deadnix": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "fail": { "type": "boolean" } }
        },
        "formatter": { "type": "string", "minLength": 1 },
        "secrets": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "tool": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "built_floor": { "type": "number", "minimum": 0, "maximum": 100 },
        "tested_floor": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "closure": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "$ref": "core/core.schema.json#/$defs/mode" },
            "outputs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        },
        "eval_cost": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "$ref": "core/core.schema.json#/$defs/mode" },
            "tolerance_pct": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vm_tests": { "$ref": "#/$defs/layer" },
        "rebuild": { "$ref": "#/$defs/layer" },
        "vulnix": { "$ref": "#/$defs/layer" },
        "lint": { "$ref": "#/$defs/layerOff" },
        "build-test": { "$ref": "#/$defs/layerOff" },
        "coverage": { "$ref": "#/$defs/layerOff" },
        "facet-layers": { "$ref": "#/$defs/layerOff" },
        "laws": { "$ref": "#/$defs/layerOff" },
        "custom": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "command"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "command": { "type": "string", "minLength": 1 },
              "tier": { "type": "integer", "minimum": 0, "maximum": 2 },
              "report": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "laws": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enable": {
          "oneOf": [
            { "const": "default" },
            { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^N-[0-9]{2}$" } }
          ]
        },
        "ack_ledger": { "type": "string", "minLength": 1 }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "path": { "type": "string", "minLength": 1 } }
    }
  }
}
