{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "FAMILY CORE. These definitions are shared by the TOPS protocols (verdicts, enforcement modes, baseline identity, acks; NIX_TOPS.md 3.3 and 6.8, blocks marked tops-core). A tops-core sync replaces this whole directory; edit Nix-specific shapes in the schemas that $ref it, not here. No $id on purpose: references are relative, so the files validate from a checkout without network access.",
  "title": "TOPS family core definitions",
  "$defs": {
    "verdict": {
      "description": "A verdict as written in text and in a verdict field (NIX_TOPS.md 3.3).",
      "enum": ["pass", "Refuse", "Ack", "skip", "not-run", "not-evaluated", "deferred", "vacuous"]
    },
    "verdictKey": {
      "description": "The same eight names as JSON keys: lower case, hyphen written as underscore (NIX_TOPS.md 3.3).",
      "enum": ["pass", "refuse", "ack", "skip", "not_run", "not_evaluated", "deferred", "vacuous"]
    },
    "verdictCounts": {
      "description": "One counter per verdict key; each is counted on its own.",
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "refuse", "ack", "skip", "not_run", "not_evaluated", "deferred", "vacuous"],
      "properties": {
        "pass": { "$ref": "#/$defs/count" },
        "refuse": { "$ref": "#/$defs/count" },
        "ack": { "$ref": "#/$defs/count" },
        "skip": { "$ref": "#/$defs/count" },
        "not_run": { "$ref": "#/$defs/count" },
        "not_evaluated": { "$ref": "#/$defs/count" },
        "deferred": { "$ref": "#/$defs/count" },
        "vacuous": { "$ref": "#/$defs/count" }
      }
    },
    "count": { "type": "integer", "minimum": 0 },
    "mode": {
      "description": "Enforcement mode (NIX_TOPS.md 6.8).",
      "enum": ["hard", "ratchet", "advisory"]
    },
    "date": {
      "description": "A UTC calendar date, YYYY-MM-DD.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "baselineIdentity": {
      "description": "What a baseline number is keyed by: implementation, version, system and lock hash (NIX_TOPS.md 2).",
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "version", "system", "lock_hash"],
      "properties": {
        "implementation": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "system": { "type": "string", "minLength": 1 },
        "lock_hash": { "type": "string", "minLength": 1 }
      }
    },
    "ack": {
      "description": "An acknowledgement: in the source (# nixtops-ack N-NN: reason) or a ledger entry, which also carries an expiry (NIX_TOPS.md 3.3).",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason"],
      "properties": {
        "kind": { "enum": ["source", "ledger"] },
        "law": { "type": "string", "pattern": "^N-[0-9]{2}$" },
        "match": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "until": { "$ref": "#/$defs/date" },
        "expired": { "type": "boolean" }
      },
      "anyOf": [{ "required": ["law"] }, { "required": ["match"] }],
      "if": { "properties": { "kind": { "const": "ledger" } } },
      "then": { "required": ["until"] }
    }
  }
}
